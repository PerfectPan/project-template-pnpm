{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/pnpm-config.schema.json",
  "useWorkspaces": true,
  "autoInstallPeers": true,
  "strictPeerDependencies": true,
  "minimumReleaseAgeMinutes": 1440,
  // The bundled vitest peers on a real `vite` range, while vite-plus provides `vite` as this core alias;
  // pnpm can only satisfy that peer through this workspace-level override. Keep the version in lockstep
  // with the `vite-plus` devDependency (same release train; dependabot does not see this file).
  "globalOverrides": {
    "vite@*": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "globalPeerDependencyRules": {
    "allowAny": [
      "vite"
    ]
  }
}
